{
  "hosting": [
    {
      "target": "chamathwanigasooriya",
      "public": "dist/chamathwanigasooriya/browser",
      "ignore": [
        "**/.*"
      ],
      "headers": [
        {
          "source": "**/*-*.@(css|js)",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public,max-age=31536000,immutable"
            }
          ]
        }
      ],
      "rewrites": [
        {
          "source": "**",
          "destination": "/index.html"
        }
      ]
    }
  ]
}